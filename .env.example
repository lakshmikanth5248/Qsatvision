# QuantumSat-AP Satellite Provider Configuration (Phase 6)
# IMPORTANT: Never commit actual API keys or credentials to version control.
# Copy this file to .env and supply your authorized provider tokens.

# Satellite Provider Selection (copernicus_dataspace, usgs_m2m, earth_search_stac, demo)
SATELLITE_PROVIDER=copernicus_dataspace
SATELLITE_API_URL=https://catalogue.dataspace.copernicus.eu/resto/api
SATELLITE_API_KEY=your_copernicus_dataspace_api_key_here

# USGS EarthExplorer / Landsat M2M Credentials
USGS_M2M_USERNAME=your_usgs_username_here
USGS_M2M_TOKEN=your_usgs_app_token_here

# Cloud Storage & Download Safety Safeguards
MAX_DOWNLOAD_SIZE_MB=1000
GEOSPATIAL_CACHE_DIR=./cache/satellite_tiles
DEFAULT_CRS=EPSG:4326

# Execution Environment Mode (DEMO or REAL)
DATA_MODE=DEMO
QUANTUM_SIMULATOR_BACKEND=statevector_simulator
MAX_QUBITS_ALLOWED=6
MAX_CIRCUIT_DEPTH=4
